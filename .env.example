# Runtime
NODE_ENV=development
PORT=5000
BASE_PATH=/

# Neon/Postgres. Use a pooled connection string in Vercel.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Application auth. Generate a long random value; never commit the real value.
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_GENERAL_EMAIL=admin@example.com
ADMIN_GENERAL_PASSWORD=replace-with-a-strong-password
ADMIN_SECONDARY_PASSWORD=replace-with-a-strong-password

# Same-origin is enough for production. Set this when the browser has another origin.
APP_ORIGIN=http://localhost:5173

# Official campaign spreadsheet (read-only).
GOOGLE_SHEETS_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/1kiOXmyCeTEWqZLhWQFfCXP8khl3F-72TNPHWlub00BI

# JSON from a Google Cloud service account with Viewer access to the spreadsheet.
# Keep it in Vercel Environment Variables as a secret. Do not commit a real value.
GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"service-account@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","token_uri":"https://oauth2.googleapis.com/token"}

# Google Calendar OAuth Web client. Keep the client secret and encryption key server-side only.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://gestaocampanha15088.vercel.app/api/calendar/google/callback
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_ID=primary
